#!/bin/sh /etc/rc.common

START=94
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Check cdk-mintd service status"

CONFIG_FILE="/etc/tollgate/mintd.toml"
MNEMONIC_FILE="/etc/tollgate/mintd.mnemonic"
WORK_DIR="/tmp/cdk-mintd"
DAEMON="/usr/bin/cdk-mintd-wrt"

start_service() {
    # Ensure work directory exists (SQLite database location)
    mkdir -p "$WORK_DIR" /etc/tollgate

    # The config's mnemonic is a `file:` secret reference (the schema no
    # longer accepts literals). Seed it on first start with the standard
    # PUBLIC BIP39 test vector — deterministic bench mint, not a secret.
    # An operator-provided file is never overwritten.
    if [ ! -f "$MNEMONIC_FILE" ]; then
        printf 'abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about' > "$MNEMONIC_FILE"
        chmod 600 "$MNEMONIC_FILE"
    fi

    # Database-backed config model: `--config` is rejected at startup.
    # Already-configured database: stage the packaged document so the
    # next start picks up packaging updates (idempotent; `config
    # rollback` still holds the previous document). Fresh database:
    # initialize from the packaged document — `--new-mint` with a
    # document that carries the seed via its `file:` mnemonic reference
    # initializes deterministically (same pubkey across DB resets).
    if ! "$DAEMON" --work-dir "$WORK_DIR" config apply --file "$CONFIG_FILE" >/tmp/cdk-mintd-config.log 2>&1; then
        if ! "$DAEMON" --work-dir "$WORK_DIR" config init --new-mint --file "$CONFIG_FILE" >>/tmp/cdk-mintd-config.log 2>&1; then
            echo "cdk-mintd config apply/init failed:" >&2
            cat /tmp/cdk-mintd-config.log >&2
            return 1
        fi
    fi

    procd_open_instance
    procd_set_param command "$DAEMON" \
        --work-dir "$WORK_DIR"
    procd_set_param respawn 3 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    echo "cdk-mintd started with config=$CONFIG_FILE workdir=$WORK_DIR" > /tmp/cdk-mintd-start.log
}

stop() {
    echo "cdk-mintd stopped" >> /tmp/cdk-mintd-start.log
}

status() {
    if pgrep -f "cdk-mintd-wrt" >/dev/null; then
        echo "cdk-mintd-wrt is running"
        return 0
    else
        echo "cdk-mintd-wrt is not running"
        return 1
    fi
}
