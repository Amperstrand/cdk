#!/bin/sh /etc/rc.common

START=94
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Check cdk-mintd service status"

start_service() {
    CONFIG_FILE="/etc/tollgate/mintd.toml"
    WORK_DIR="/tmp/cdk-mintd"

    # Ensure work directory exists (SQLite database location)
    mkdir -p "$WORK_DIR"

    procd_open_instance
    procd_set_param command /usr/bin/cdk-mintd-wrt \
        --config "$CONFIG_FILE" \
        --work-dir "$WORK_DIR"
    procd_set_param respawn 3 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    echo "cdk-mintd started with config=$CONFIG_FILE workdir=$WORK_DIR" > /tmp/cdk-mintd-start.log
}

stop() {
    echo "cdk-mintd stopped" >> /tmp/cdk-mintd-start.log
}

status() {
    if pgrep -f "cdk-mintd-wrt" >/dev/null; then
        echo "cdk-mintd-wrt is running"
        return 0
    else
        echo "cdk-mintd-wrt is not running"
        return 1
    fi
}
